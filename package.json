{
  "name": "routebook",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source routebook built on live ERA RINF data",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" --filter \"./apps/**\" run build",
    "test": "vitest run",
    "typecheck": "pnpm -r run typecheck && tsc -p tsconfig.tests.json",
    "fetch:nor": "pnpm --filter @routebook/cli start fetch --country NOR",
    "route": "pnpm --filter @routebook/cli start route",
    "dev:web": "pnpm --filter @routebook/web dev",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright-core": "^1.64.0",
    "typescript": "~5.8.3",
    "vitest": "^3.2.7"
  }
}
