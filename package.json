{
  "name": "routebook",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source routebook built on live ERA RINF data",
  "homepage": "https://github.com/Matdata-eu/rinf-routebook#readme",
  "repository": { "type": "git", "url": "git+https://github.com/Matdata-eu/rinf-routebook.git" },
  "bugs": { "url": "https://github.com/Matdata-eu/rinf-routebook/issues" },
  "author": "Mathias Vanden Auweele (https://matdata.eu)",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/**\" --filter \"./apps/**\" run build",
    "test": "vitest run",
    "typecheck": "pnpm -r run typecheck && tsc -p tsconfig.tests.json",
    "routebook": "pnpm --filter @routebook/cli start",
    "fetch:nor": "pnpm --filter @routebook/cli start fetch --dataset NOR",
    "fetch:all": "pnpm --filter @routebook/cli start fetch-all",
    "bundle:nor": "pnpm --filter @routebook/cli start bundle --dataset NOR",
    "route": "pnpm --filter @routebook/cli start route",
    "dev:web": "pnpm --filter @routebook/web dev",
    "screenshots": "node scripts/screenshots.mjs",
    "demo": "pnpm build && node scripts/demo.mjs",
    "serve": "node scripts/demo.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "playwright-core": "^1.64.0",
    "typescript": "~5.8.3",
    "vitest": "^4.1.11"
  }
}
