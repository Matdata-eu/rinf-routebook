{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "declaration": false,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@routebook/rinf-client/compact": ["packages/rinf-client/src/compact.ts"],
      "@routebook/rinf-client/network-index": ["packages/rinf-client/src/network-index.ts"],
      "@routebook/*": ["packages/*/src/index.ts"]
    }
  },
  "include": ["packages/*/test/**/*.ts", "apps/*/test/**/*.ts", "scripts/test/**/*.ts"]
}
