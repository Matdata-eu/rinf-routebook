# Copy to .env (never committed). ArcGIS Location Platform key with the Basemaps privilege: the
# server adds it to the Esri World Imagery tile requests, it never reaches the browser.
ESRI_API_KEY=
# ROUTEBOOK_PORT=8081          # host port the reverse proxy forwards to
# ROUTEBOOK_VERSION=latest     # image tag: latest, edge, or x.y.z
# ROUTEBOOK_SYNC_MINUTES=60
