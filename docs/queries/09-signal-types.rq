# Signals per type
# Endpoint: https://graph.data.era.europa.eu/repositories/rinf-plus  (Norway / Bane NOR = graph <http://data.europa.eu/949/graph/0076>)
PREFIX era:  <http://data.europa.eu/949/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX geo:  <http://www.opengis.net/ont/geosparql#>

SELECT ?t ?label (COUNT(*) AS ?n) WHERE {
  GRAPH <http://data.europa.eu/949/graph/0076> { ?s a era:Signal ; era:signalType ?t }
  OPTIONAL { ?t skos:prefLabel ?label FILTER(lang(?label) = "en") }
} GROUP BY ?t ?label ORDER BY DESC(?n)
