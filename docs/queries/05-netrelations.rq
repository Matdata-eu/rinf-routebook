# Micro topology edges: NetRelations (navigability Both/None). Output = rel.csv for route_test.py
# Endpoint: https://graph.data.era.europa.eu/repositories/rinf-plus  (Norway / Bane NOR = graph <http://data.europa.eu/949/graph/0076>)
PREFIX era:  <http://data.europa.eu/949/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX geo:  <http://www.opengis.net/ont/geosparql#>

SELECT ?r ?a ?b ?oa ?ob ?nav WHERE { GRAPH <http://data.europa.eu/949/graph/0076> {
  ?r a era:NetRelation ; era:elementA ?a ; era:elementB ?b ;
     era:isOnOriginOfElementA ?oa ; era:isOnOriginOfElementB ?ob ; era:navigability ?nav } }
