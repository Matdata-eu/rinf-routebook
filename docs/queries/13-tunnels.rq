# Tunnels with id, length and start/end positions (topo + LRS)
# Endpoint: https://graph.data.era.europa.eu/repositories/rinf-plus  (Norway / Bane NOR = graph <http://data.europa.eu/949/graph/0076>)
PREFIX era:  <http://data.europa.eu/949/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX geo:  <http://www.opengis.net/ont/geosparql#>

SELECT ?t ?id ?len ?neS ?offS ?kmS ?offKmS ?neE ?offE WHERE { GRAPH <http://data.europa.eu/949/graph/0076> {
  ?t a era:Tunnel ; era:tunnelIdentification ?id ; era:lineReferenceTunnelStart ?s ; era:lineReferenceTunnelEnd ?e .
  OPTIONAL { ?t era:lengthOfTunnel ?len }
  ?s era:hasTopoCoordinate [ era:onLinearElement ?neS ; era:offsetFromOrigin ?offS ] .
  ?e era:hasTopoCoordinate [ era:onLinearElement ?neE ; era:offsetFromOrigin ?offE ] .
  OPTIONAL { ?s era:hasLrsCoordinate [ era:kmPost/era:kilometer ?kmS ; era:offsetFromKilometricPost ?offKmS ] }
} }
