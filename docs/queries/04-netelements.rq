# Micro topology nodes: LinearElements with length (m). Output = ne.csv for route_test.py
# Endpoint: https://graph.data.era.europa.eu/repositories/rinf-plus  (Norway / Bane NOR = graph <http://data.europa.eu/949/graph/0076>)
PREFIX era:  <http://data.europa.eu/949/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX geo:  <http://www.opengis.net/ont/geosparql#>

SELECT ?e ?len WHERE { GRAPH <http://data.europa.eu/949/graph/0076> { ?e a era:LinearElement ; era:lengthOfNetLinearElement ?len } }
