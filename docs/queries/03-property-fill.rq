# Property fill for one class: distinct subjects per predicate. Change the VALUES class.
# Endpoint: https://graph.data.era.europa.eu/repositories/rinf-plus  (Norway / Bane NOR = graph <http://data.europa.eu/949/graph/0076>)
PREFIX era:  <http://data.europa.eu/949/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX geo:  <http://www.opengis.net/ont/geosparql#>

SELECT ?p (COUNT(DISTINCT ?s) AS ?subjects) (COUNT(*) AS ?triples) WHERE {
  VALUES ?class { era:RunningTrack }   # e.g. era:OperationalPoint era:SectionOfLine era:Signal era:Switch era:Tunnel era:KilometricPost
  GRAPH <http://data.europa.eu/949/graph/0076> { ?s a ?class ; ?p ?o }
} GROUP BY ?p ORDER BY DESC(?subjects)
