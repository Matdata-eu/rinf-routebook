# Is a property used at all, in Norway vs. all IMs (gap check)
# Endpoint: https://graph.data.era.europa.eu/repositories/rinf-plus  (Norway / Bane NOR = graph <http://data.europa.eu/949/graph/0076>)
PREFIX era:  <http://data.europa.eu/949/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX geo:  <http://www.opengis.net/ont/geosparql#>

SELECT ?p (SUM(IF(?g = <http://data.europa.eu/949/graph/0076>, 1, 0)) AS ?norway) (COUNT(*) AS ?all) (COUNT(DISTINCT ?g) AS ?graphs) WHERE {
  VALUES ?p { era:signalId era:signalOrientation era:lengthOfNonStoppingArea era:maximumSpeedAndCantDeficiency era:lineNationalId era:hasImplementation era:gradient era:gradientProfile era:kilometer era:phaseInfoKm }
  GRAPH ?g { ?s ?p ?o }
} GROUP BY ?p
