# Point features (signals, switches, km posts, level crossings) with topo + LRS position and direction
# Endpoint: https://graph.data.era.europa.eu/repositories/rinf-plus  (Norway / Bane NOR = graph <http://data.europa.eu/949/graph/0076>)
PREFIX era:  <http://data.europa.eu/949/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX geo:  <http://www.opengis.net/ont/geosparql#>

SELECT ?f ?class ?label ?ne ?off ?dir ?km ?offKm WHERE { GRAPH <http://data.europa.eu/949/graph/0076> {
  VALUES ?class { era:Signal era:Switch era:KilometricPost era:LevelCrossing }
  ?f a ?class ; era:netReference ?r .
  OPTIONAL { ?f rdfs:label ?label }
  ?r era:hasTopoCoordinate ?tc . ?tc era:onLinearElement ?ne ; era:offsetFromOrigin ?off .
  OPTIONAL { ?r era:appliesToDirection ?dir }
  OPTIONAL { ?r era:hasLrsCoordinate ?lc . ?lc era:kmPost/era:kilometer ?km ; era:offsetFromKilometricPost ?offKm }
} }
