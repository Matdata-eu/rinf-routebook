# National lines (docs/queries/11)
# {{graph}} is replaced by the country named graph IRI (Norway: <http://data.europa.eu/949/graph/0076>).
# Derived from docs/queries (step-1 coverage check).
PREFIX era:  <http://data.europa.eu/949/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX geo:  <http://www.opengis.net/ont/geosparql#>

SELECT ?line (SAMPLE(?l) AS ?label) WHERE { GRAPH {{graph}} {
  ?sol a era:SectionOfLine ; era:nationalLine ?line . OPTIONAL { ?line rdfs:label ?l } } } GROUP BY ?line
