# Operational points with type and WKT
# {{graph}} is replaced by the country named graph IRI (Norway: <http://data.europa.eu/949/graph/0076>).
# Derived from docs/queries (step-1 coverage check).
PREFIX era:  <http://data.europa.eu/949/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX geo:  <http://www.opengis.net/ont/geosparql#>

SELECT ?op ?uopid ?name ?type ?wkt WHERE { GRAPH {{graph}} {
  ?op a era:OperationalPoint ; era:uopid ?uopid ; era:opName ?name .
  OPTIONAL { ?op era:opType ?type }
  OPTIONAL { ?op (geo:hasGeometry|era:netReference/geo:hasGeometry)/geo:asWKT ?wkt }
} }
