# OP centre points: topological + LRS coordinate (docs/queries/07)
# {{graph}} is replaced by the country named graph IRI (Norway: <http://data.europa.eu/949/graph/0076>).
# Derived from docs/queries (step-1 coverage check).
PREFIX era:  <http://data.europa.eu/949/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX geo:  <http://www.opengis.net/ont/geosparql#>

SELECT ?op ?ne ?off ?km ?offKm ?lrs WHERE { GRAPH {{graph}} {
  ?op a era:OperationalPoint ; era:netReference ?p .
  ?p a era:NetPointReference ; era:hasTopoCoordinate ?tc .
  ?tc era:onLinearElement ?ne ; era:offsetFromOrigin ?off .
  OPTIONAL { ?p era:hasLrsCoordinate ?lc . ?lc era:kmPost ?kp ; era:offsetFromKilometricPost ?offKm . ?kp era:kilometer ?km . OPTIONAL { ?kp era:hasLRS ?lrs } }
} }
