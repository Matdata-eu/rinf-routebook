# OP -> micro NetElements via NetAreaReference (docs/queries/06)
# {{graph}} is replaced by the country named graph IRI (Norway: <http://data.europa.eu/949/graph/0076>).
# Derived from docs/queries (step-1 coverage check).
PREFIX era:  <http://data.europa.eu/949/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX geo:  <http://www.opengis.net/ont/geosparql#>

SELECT ?op ?ne ?startOff ?endOff WHERE { GRAPH {{graph}} {
  ?op a era:OperationalPoint ; era:netReference ?area .
  ?area a era:NetAreaReference ; era:includes ?list .
  ?list rdf:rest*/rdf:first ?lin .
  ?lin era:startsAt/era:hasTopoCoordinate ?sc ; era:endsAt/era:hasTopoCoordinate ?ec .
  ?sc era:onLinearElement ?ne ; era:offsetFromOrigin ?startOff .
  ?ec era:offsetFromOrigin ?endOff .
} }
