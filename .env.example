# Settings for docker compose (copy to .env; .env is never committed).

# RINF datasets the container fetches and keeps current: ISO 3166-1 alpha-3 country codes,
# IM codes (e.g. 0076) or named graph IRIs, separated by commas. List them with:
#   docker compose run --rm routebook routebook datasets
# "all" keeps every dataset on the endpoint, one per country (the first fetch takes a while).
ROUTEBOOK_DATASETS=NOR
# ROUTEBOOK_SYNC_MINUTES=60    # how often to check ERA for new publications; 0 = only fetch on start
# NODE_OPTIONS=--max-old-space-size=8192   # for "all": the largest networks need a bigger heap
# ROUTEBOOK_REFRESH=1          # fetch them all again on the next start
# ROUTEBOOK_DEFAULT_DATASET=nor
# ROUTEBOOK_TITLE=Routebook
# ROUTEBOOK_PRIVACY_URL=https://example.org/privacy     # or ROUTEBOOK_PRIVACY_FILE=/config/privacy.html
# ROUTEBOOK_PORT=8080
# ROUTEBOOK_VERSION=latest     # image tag
# ROUTEBOOK_SPARQL_ENDPOINT=https://graph.data.era.europa.eu/repositories/rinf-plus

# Esri World Imagery as an "Aerial" background (ArcGIS Location Platform API key with
# the Basemaps privilege). The server adds the key to the tile requests: it never
# reaches the browser.
# ESRI_API_KEY=

# A self-hosted street map instead of the OpenStreetMap tiles: a Protomaps PMTiles file in
# ./basemap (mounted at /data/basemap, see docker-compose.yml and docs/deployment.md).
# ROUTEBOOK_BASEMAP_PMTILES=nordics.pmtiles

# Keys used in config/config.json as ${NAME}, for example:
# ORTHO_API_KEY=
